<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Balances · Dental Lab Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav', { user, active }) %>

  <div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
      <div>
        <h1 class="h4 mb-0">Outstanding balances</h1>
        <div class="small text-muted">Balance = invoiced &minus; received. &ldquo;Cr&rdquo; means the doctor has paid in advance.</div>
      </div>
      <form method="get" action="/balances" class="mb-0">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="only" value="due" id="onlyDue" <%= onlyDue ? 'checked' : '' %> onchange="this.form.submit()">
          <label class="form-check-label" for="onlyDue">Only doctors who owe money</label>
        </div>
        <noscript><button class="btn btn-sm btn-primary mt-1">Apply</button></noscript>
      </form>
    </div>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-bordered table-grid table-striped table-hover table-sm mb-0">
          <thead>
            <tr>
              <th>Dr. Name</th><th>Invoiced</th><th>Received</th><th>Balance</th>
              <th>Delivered, not invoiced</th><th>Not delivered yet</th><th>Last invoice</th><th>Last payment</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="9" class="text-center text-muted py-4"><%= onlyDue ? 'No doctor owes money right now' : 'No doctors yet' %></td></tr>
            <% } %>
            <% rows.forEach((r) => { const b = Number(r.balance); %>
              <tr>
                <td><%= r.name %></td>
                <td class="num"><%= inr(r.invoiced) %></td>
                <td class="num"><%= inr(r.received) %></td>
                <td class="num fw-semibold <%= b > 0 ? 'text-danger' : b < 0 ? 'text-success' : '' %>"><%= inrBal(r.balance) %></td>
                <td class="num"><%= inr(r.delivered_unbilled) %></td>
                <td class="num"><%= inr(r.pending) %></td>
                <td class="text-nowrap"><%= r.last_invoice ? monthLabel(r.last_invoice) : '' %></td>
                <td class="text-nowrap"><%= dmy(r.last_payment) %></td>
                <td class="text-center text-nowrap">
                  <a class="btn btn-sm btn-outline-primary" href="/invoices?doctor_id=<%= r.id %>">Invoices</a>
                  <a class="btn btn-sm btn-outline-secondary" href="/payments?doctor_id=<%= r.id %>">Payments</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="fw-semibold">
              <td>Total (<%= rows.length %> doctor<%= rows.length === 1 ? '' : 's' %>)</td>
              <td class="num"><%= inr(totals.invoiced) %></td>
              <td class="num"><%= inr(totals.received) %></td>
              <td class="num"><%= inrBal(totals.balance) %></td>
              <td class="num"><%= inr(totals.delivered_unbilled) %></td>
              <td class="num"><%= inr(totals.pending) %></td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
    <div class="small text-muted mt-2">
      &ldquo;Delivered, not invoiced&rdquo; is work on a delivery challan that will appear on the next invoice.
      &ldquo;Not delivered yet&rdquo; is work still in the lab.
    </div>
  </div>
</body>
</html>
