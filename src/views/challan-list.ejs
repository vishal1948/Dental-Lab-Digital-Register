<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Challans · Dental Lab Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav', { user, active }) %>
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h4 mb-0">Delivery challans</h1>
      <form method="get" action="/challans" class="d-flex gap-2">
        <input type="month" name="month" value="<%= month %>" class="form-control form-control-sm" onchange="this.form.submit()">
        <noscript><button class="btn btn-sm btn-primary">Show</button></noscript>
      </form>
    </div>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-bordered table-grid table-striped table-hover table-sm mb-0">
          <thead>
            <tr><th>Challan No.</th><th>Date</th><th>Dr. Name</th><th>Cases</th><th>Total</th><th></th></tr>
          </thead>
          <tbody>
            <% if (!challans.length) { %>
              <tr><td colspan="6" class="text-center text-muted py-4">No challans issued in this month</td></tr>
            <% } %>
            <% challans.forEach((c) => { %>
              <tr>
                <td><%= c.challan_no %></td>
                <td class="text-nowrap"><%= dmy(c.challan_date) %></td>
                <td><%= c.doctor %></td>
                <td class="num"><%= c.cases %></td>
                <td class="num"><%= inr(c.total) %></td>
                <td class="text-center"><a class="btn btn-sm btn-outline-primary" href="/challans/<%= c.id %>">View / Print</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
