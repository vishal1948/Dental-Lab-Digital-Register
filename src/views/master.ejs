<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= cfg.title %> · Dental Lab Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav', { user, active }) %>

  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 gap-3">
      <h1 class="h4 mb-0"><%= cfg.title %></h1>
      <div class="d-flex gap-2">
        <input id="search" class="form-control form-control-sm" style="width: 220px" placeholder="Search…" autocomplete="off">
        <% if (cfg.canEdit) { %>
          <button id="addBtn" class="btn btn-primary btn-sm text-nowrap">+ Add</button>
        <% } %>
      </div>
    </div>

    <div id="alert" class="alert d-none" role="alert"></div>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-bordered table-grid table-striped table-hover mb-0 align-middle">
          <thead>
            <tr>
              <% cfg.columns.forEach((c) => { %><th><%= c.label %></th><% }) %>
              <% if (cfg.canEdit || cfg.hasRates) { %><th></th><% } %>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (cfg.canEdit) { %>
  <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="editForm" novalidate>
        <div class="modal-header">
          <h2 class="modal-title h5" id="modalTitle"></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="formError" class="alert alert-danger py-2 d-none"></div>
          <% cfg.columns.forEach((c) => { %>
            <div class="mb-3">
              <label class="form-label" for="f_<%= c.name %>"><%= c.label %><%= c.required ? ' *' : '' %></label>
              <input class="form-control" id="f_<%= c.name %>" name="<%= c.name %>"
                     <% if (c.type === 'number') { %>type="number" step="0.01" min="0"<% } else { %>type="text" maxlength="200"<% } %>>
            </div>
          <% }) %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveBtn">Save</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <% if (cfg.hasRates) { %>
  <div class="modal fade" id="ratesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
      <form class="modal-content" id="ratesForm">
        <div class="modal-header">
          <h2 class="modal-title h5" id="ratesTitle"></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="ratesError" class="alert alert-danger py-2 d-none"></div>
          <% if (cfg.canEdit) { %>
            <select id="copyFrom" class="form-select form-select-sm mb-2">
              <option value="">Copy rates from another doctor…</option>
            </select>
            <div id="ratesNote" class="alert alert-info py-2 small d-none"></div>
            <p class="small text-muted">Leave a rate blank to use the default rate.</p>
          <% } %>
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Work type</th><th class="text-end">Default</th><th>This doctor</th></tr></thead>
            <tbody id="ratesBody"></tbody>
          </table>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
          <% if (cfg.canEdit) { %><button type="submit" class="btn btn-primary" id="ratesSave">Save rates</button><% } %>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <script id="cfg" type="application/json"><%- JSON.stringify(cfg).replace(/</g, '\\u003c') %></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/master.js"></script>
</body>
</html>
