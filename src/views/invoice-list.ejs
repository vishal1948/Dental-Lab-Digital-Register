<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Invoices · Dental Lab Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav', { user, active }) %>

  <div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
      <h1 class="h4 mb-0">Invoices</h1>
      <div class="d-flex gap-2 align-items-center">
        <form method="get" action="/invoices" class="d-flex gap-2 mb-0">
          <select name="doctor_id" class="form-select form-select-sm" style="width: 200px" onchange="this.form.submit()">
            <option value="">All doctors</option>
            <% doctors.forEach((d) => { %><option value="<%= d.id %>" <%= doctorId === d.id ? 'selected' : '' %>><%= d.name %></option><% }) %>
          </select>
          <input type="month" name="month" value="<%= month %>" class="form-control form-control-sm" style="width: 160px"
                 onchange="this.form.submit()" title="Billing month (clear it to see all months)">
          <noscript><button class="btn btn-sm btn-primary">Filter</button></noscript>
        </form>
        <% if (canEdit) { %>
          <button id="newInvoiceBtn" class="btn btn-primary btn-sm text-nowrap" <%= doctors.length ? '' : 'disabled' %>>+ New invoice</button>
        <% } %>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-bordered table-grid table-striped table-hover table-sm mb-0">
          <thead>
            <tr>
              <th>Invoice No.</th><th>Billing Month</th><th>Invoice Date</th><th>Dr. Name</th><th>Cases</th>
              <th>Previous Balance</th><th>Bill</th><th>Payments</th><th>Balance Due</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!invoices.length) { %>
              <tr><td colspan="10" class="text-center text-muted py-4">No invoices found</td></tr>
            <% } %>
            <% invoices.forEach((i) => { %>
              <tr>
                <td><%= i.invoice_no %></td>
                <td class="text-nowrap"><%= monthLabel(i.period_month) %></td>
                <td class="text-nowrap"><%= dmy(i.invoice_date) %></td>
                <td><%= i.doctor %></td>
                <td class="num"><%= i.case_count %></td>
                <td class="num"><%= inrBal(i.previous_balance) %></td>
                <td class="num"><%= inr(i.bill_total) %></td>
                <td class="num"><%= inr(i.payments_total) %></td>
                <td class="num fw-semibold"><%= inrBal(i.total_balance) %></td>
                <td class="text-center"><a class="btn btn-sm btn-outline-primary" href="/invoices/<%= i.id %>">View / Print</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (canEdit) { %>
  <div class="modal fade" id="invoiceModal" tabindex="-1" aria-hidden="true" data-today="<%= today %>" data-month="<%= defaultMonth %>">
    <div class="modal-dialog">
      <form class="modal-content" id="invoiceForm">
        <div class="modal-header">
          <h2 class="modal-title h5">New invoice</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="invoiceError" class="alert alert-danger py-2 d-none"></div>
          <div class="row g-3 mb-3">
            <div class="col-md-5">
              <label class="form-label" for="n_doctor">Dr. Name *</label>
              <select class="form-select" id="n_doctor" required>
                <option value="">Select…</option>
                <% doctors.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="n_month">Billing month *</label>
              <input type="month" class="form-control" id="n_month" required>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="n_date">Invoice date</label>
              <input type="date" class="form-control" id="n_date">
            </div>
          </div>
          <div id="previewBox"></div>
          <div class="form-text mt-2">Bills this doctor's delivered cases (on a delivery challan dated up to the end of the billing month) that haven't been billed yet.</div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success" id="issueInvoiceBtn" disabled>Issue &amp; open invoice</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/invoices.js"></script>
</body>
</html>
