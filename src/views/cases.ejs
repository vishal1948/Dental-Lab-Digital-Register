<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cases · Dental Lab Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav', { user, active }) %>

  <div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" id="prevMonth" title="Previous month">&lsaquo;</button>
        <input type="month" id="month" class="form-control form-control-sm" style="width: 160px">
        <button class="btn btn-outline-secondary btn-sm" id="nextMonth" title="Next month">&rsaquo;</button>
        <select id="doctorFilter" class="form-select form-select-sm" style="width: 200px">
          <option value="">All doctors</option>
          <% cfg.doctors.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="d-flex gap-2">
        <input id="search" class="form-control form-control-sm" style="width: 260px" placeholder="Search patient, Sr. No., model…" autocomplete="off">
        <% if (cfg.canEdit) { %>
          <button id="issueBtn" class="btn btn-outline-success btn-sm text-nowrap" disabled>Issue delivery challan</button>
          <button id="addBtn" class="btn btn-primary btn-sm text-nowrap" <%= cfg.doctors.length ? '' : 'disabled' %>>+ New case</button>
        <% } %>
      </div>
    </div>

    <% if (!cfg.doctors.length) { %>
      <div class="alert alert-warning">Add at least one <a href="/doctors">doctor</a> before entering cases.</div>
    <% } %>
    <div id="alert" class="alert d-none" role="alert"></div>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-bordered table-grid table-striped table-hover table-sm mb-0">
          <thead>
            <tr>
              <% if (cfg.canEdit) { %><th style="width: 36px"><input type="checkbox" id="selectAll" class="form-check-input" title="Select all undelivered cases"></th><% } %>
              <th>Sr. No.</th><th>Date</th><th>Model No.</th><th>Tooth No.</th><th>Work Type</th>
              <th>Dr. Name</th><th>Patient Name</th><th>Delivery Challan No. / Date</th><th>Delivery Date</th>
              <th class="num">Qty</th><th class="num">Rate</th><th class="num">Total</th>
              <% if (cfg.canEdit) { %><th></th><% } %>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
          <tfoot>
            <tr><td colspan="<%= cfg.canEdit ? 14 : 12 %>" id="summary" class="fw-semibold"></td></tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <% if (cfg.canEdit) { %>
  <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <form class="modal-content" id="editForm">
        <div class="modal-header">
          <h2 class="modal-title h5" id="modalTitle"></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="formError" class="alert alert-danger py-2 d-none"></div>
          <div id="lockNote" class="alert alert-warning py-2 d-none"></div>
          <!-- Field order follows the paper register: Date, Model, Tooth, Work type, Dr., Patient, Delivery… -->
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" for="f_case_date">Date *</label>
              <input type="date" class="form-control" id="f_case_date" required>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f_model_no">Model No.</label>
              <input class="form-control" id="f_model_no" maxlength="50" autocomplete="off">
            </div>
            <div class="col-md-4">
              <label class="form-label">Sr. No.</label>
              <div class="form-control-plaintext fw-semibold" id="srNoText"></div>
            </div>

            <div class="col-12">
              <label class="form-label">Tooth No. <span class="text-muted small">(click to select · quantity follows the count unless you change it)</span></label>
              <div class="teeth-chart border rounded p-2 bg-white">
                <% const layout = [
                     [['UR', 'Upper Right', [8,7,6,5,4,3,2,1]], ['UL', 'Upper Left', [1,2,3,4,5,6,7,8]]],
                     [['LR', 'Lower Right', [8,7,6,5,4,3,2,1]], ['LL', 'Lower Left', [1,2,3,4,5,6,7,8]]],
                   ]; %>
                <% layout.forEach((pair, i) => { %>
                  <% if (i === 1) { %><hr class="my-2"><% } %>
                  <div class="row g-0">
                    <% pair.forEach(([q, label, nums], j) => { %>
                      <div class="col-6 quad <%= j === 0 ? 'pe-2 border-end text-end' : 'ps-2' %>">
                        <div class="small text-muted mb-1"><%= label %></div>
                        <div class="d-flex gap-1 <%= j === 0 ? 'justify-content-end' : '' %>">
                          <% nums.forEach((n) => { %>
                            <button type="button" class="tooth btn btn-sm btn-outline-secondary" data-q="<%= q %>" data-n="<%= n %>"><%= n %></button>
                          <% }) %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="col-md-4">
              <label class="form-label" for="f_work_type_id">Work Type</label>
              <select class="form-select" id="f_work_type_id">
                <option value="">Select…</option>
                <% cfg.workTypes.forEach((w) => { %><option value="<%= w.id %>"><%= w.name %></option><% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f_doctor_id">Dr. Name *</label>
              <select class="form-select" id="f_doctor_id" required>
                <option value="">Select…</option>
                <% cfg.doctors.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
              </select>
              <div class="form-text" id="doctorLockHint"></div>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f_patient_name">Patient Name *</label>
              <input class="form-control" id="f_patient_name" maxlength="200" required autocomplete="off">
            </div>

            <div class="col-md-4">
              <label class="form-label">Delivery Challan</label>
              <div class="form-control-plaintext" id="challanText"></div>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f_delivery_date">Delivery Date</label>
              <input type="date" class="form-control" id="f_delivery_date">
            </div>
            <div class="col-md-4">
              <label class="form-label">Total</label>
              <div class="form-control-plaintext fw-semibold" id="totalPreview">₹ 0.00</div>
            </div>

            <div class="col-md-2 col-6">
              <label class="form-label" for="f_qty">Qty</label>
              <input type="number" class="form-control" id="f_qty" min="1" max="999" step="1" value="1">
            </div>
            <div class="col-md-3 col-6">
              <label class="form-label" for="f_rate">Rate (₹)</label>
              <input type="number" class="form-control" id="f_rate" min="0" step="0.01">
              <div class="form-text" id="rateHint"></div>
            </div>
            <div class="col-md-7">
              <label class="form-label" for="f_notes">Notes</label>
              <input class="form-control" id="f_notes" maxlength="1000" autocomplete="off">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-outline-primary" id="saveAgainBtn">Save &amp; add another</button>
          <button type="submit" class="btn btn-primary" id="saveBtn">Save</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal fade" id="challanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" id="challanForm">
        <div class="modal-header">
          <h2 class="modal-title h5">Issue delivery challan</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="challanError" class="alert alert-danger py-2 d-none"></div>
          <p id="challanSummary" class="fw-semibold mb-3"></p>
          <label class="form-label" for="f_challan_date">Challan date *</label>
          <input type="date" class="form-control" id="f_challan_date" required>
          <div class="form-text">The challan number is generated automatically. You can print it on the next screen.</div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success" id="issueConfirmBtn">Issue &amp; open challan</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <script id="cfg" type="application/json"><%- JSON.stringify(cfg).replace(/</g, '\\u003c') %></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/cases.js"></script>
</body>
</html>
